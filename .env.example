
# model providers & api keys 

LM_URL=http://host.docker.internal:1234            # LM Studio endpoint (chat, SDXL rewrite, embeddings)
LM_DEFAULT_MODEL=your-rewrite-model
LM_CHAT_MODEL=your-chat-model                       # main chat model; empty => falls back to LM_DEFAULT_MODEL
LM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5 # load an embedding model in LM Studio; set its API id

OPENROUTER_DEFAULT_MODEL=openrouter/your-default-model
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HF_TOKEN=            # huggingface token (required to train FLUX.1-dev; gated repo)

# image LoRA training / generation with trained LoRAs
# COMFY_LORA_DIR=          # host path of your ComfyUI models/loras folder (bind-mounted into the backend)
# COMFY_LORA_CONTAINER_PATH=/comfy-loras  # container path backend writes LoRAs to (leave default)
# SDXL_MODEL_PATH=         # host path to your SDXL model for training; empty => HF download (~7GB, not recommended)
# SDXL_MODEL_NAME=         # optional filename inside SDXL_MODEL_PATH (e.g. "sdxl-base.safetensors")
# SD1_MODEL_PATH=          # host path to your SD1 model for training; empty => HF download (~4GB, not recommended)
# SD1_MODEL_NAME=          # optional filename inside SD1_MODEL_PATH (e.g. "sd15-base.safetensors")

# PostgreSQL and redis

# Postgres user/db are read by docker-compose (required) and must match the
# credentials embedded in DATABASE_URL.
POSTGRES_USER=ishaab
POSTGRES_DB=llmgateway
DATABASE_URL=postgresql://ishaab:change-me@postgres/llmgateway
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379

# Grafana admin password (read by docker-compose; ignored by the app)
GRAFANA_ADMIN_PASSWORD=change-me

# JWT settings 
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256

# token expiry

ACCESS_TOKEN_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7

# agent / MCP tools (all optional; defaults shown)

# AGENT_MAX_ITERATIONS=6
# AGENT_TOKEN_BUDGET=24000
# TOOL_TIMEOUT_SECONDS=30
# SEARXNG_URL=                       # self-hosted SearXNG; empty => DuckDuckGo fallback for web_search
# WARNING: MCP_SERVERS is operator-configured and can spawn arbitrary commands
# (stdio transport runs whatever `command` says). NEVER allow user input to
# reach this setting — treat it as trusted configuration, like a Dockerfile.
# MCP_SERVERS=[{"name":"fs","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/data"]}]

# deep research (optional; defaults shown)

# RESEARCH_MAX_QUERIES=4
# RESEARCH_RESULTS_PER_QUERY=4
# RESEARCH_MAX_SOURCES=6
# RESEARCH_PAGE_MAX_CHARS=6000
# RESEARCH_JOB_TIMEOUT_SECONDS=900

# hardware probe / cookbook (optional; defaults shown)

# COOKBOOK_CONTEXT_TOKENS=8192
# Total host RAM in MB for the RAM-offload fit verdict. 0 = auto-detect from
# /proc/meminfo. Set explicitly (e.g. 16384) when the backend runs in a VM whose
# /proc/meminfo under-reports (Docker Desktop's WSL2 backend reports the VM's
# memory allocation, not the host's physical RAM).
# HOST_RAM_MB=0

# langfuse

LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com
